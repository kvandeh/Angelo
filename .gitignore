# target/ rather than /target: the crate builds in Angelo/target and the
# SonarQube plugin builds in integrations/sonarqube/target.
target/
dist/
.angelo/
__pycache__/
.pytest_cache/
extra/
site/
.zensical/
.cache
.claude

# The corpus experiment: its scripts, manifest and board are the record worth
# keeping. Its venv, per-run logs, generated reports and results are not.
experiment/.venv/
experiment/logs/
experiment/reports/
experiment/state/
experiment/results.jsonl
# Timestamped backups the harness makes before each run. The one hand-recovered
# copy of the destroyed 50-repo dataset is kept under its own name.
experiment/results.jsonl.*-*.bak

# Working documents that live here but are not part of the project. Word also
# leaves a ~$ lock file beside an open one.
*.docx
~$*
